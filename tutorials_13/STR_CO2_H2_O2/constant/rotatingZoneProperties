FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      rotatingZoneProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

origin  (0 0 0);
axis    (0 0 -1);

omega
{
    type    scale;

    scale
    {
        type        linearRamp;

        start       0.1;
        duration    0.5;
    }

    value   100 [rpm];
}

