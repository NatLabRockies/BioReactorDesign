FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 86126.2;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"
    outlet
    {
        type            calculated;
        value           uniform 86126.2;
    }
    propeller
    {
        type            calculated;
        value           uniform 86126.2;
    }
    "vessel|shaft|walls|impeller"
    {
        type            calculated;
        value           uniform 86126.2;
    }

    nonCouple
    {
        type            zeroGradient;
    }
}


