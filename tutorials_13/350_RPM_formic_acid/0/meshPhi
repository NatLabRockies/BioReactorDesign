FoamFile
{
    format      ascii;
    class       surfaceScalarField;
    location    "0";
    object      meshPhi;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 3 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"
    outlet
    {
        type            calculated;
        value           uniform 0;
    }
    propeller
    {
        type            calculated;
        value           uniform 0;
    }
    "vessel|shaft|walls|impeller"
    {
        type            calculated;
        value           uniform 0;
    }

    nonCouple
    {
        type            calculated;
        value           uniform 0;
    }
}


