FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      alphat.gas;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"
    outlet
    {
        type            calculated;
        value           uniform 0;
    }
    propeller
    {
        type            compressible::alphatWallFunction;
        Prt             0.85;
        value           uniform 0;
    }
    "vessel|shaft|walls|impeller"
    {
        type            compressible::alphatWallFunction;
        Prt             0.85;
        value           $internalField;
    }
    
    nonCouple
    {
        type            zeroGradient;
    }
}

    massSource
    {
        type            uniformFixedValue;
        uniformValue    0;
    }


// ************************************************************************* //
