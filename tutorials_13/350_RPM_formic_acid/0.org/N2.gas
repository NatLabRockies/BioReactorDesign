FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      N2.gas;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 1;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"
    outlet
    {
        type            inletOutlet;
        phi             phi.gas;
        inletValue      uniform 1;
        value           uniform 1;
    }
    propeller
    {
        type            zeroGradient;
    }
    "vessel|shaft|walls|impeller"
    {
        type            zeroGradient;
        value           $internalField;
    }

    nonCouple
    {
        type            zeroGradient;
    }
}

sources
{
    massSource
    {
        type            uniformFixedValue;
        uniformValue    0.79;
    }

}
// ************************************************************************* //
