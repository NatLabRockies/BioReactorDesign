FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      alpha.liquid;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [];

internalField  uniform 0;

    massSource
    {
        type            uniformFixedValue;
        uniformValue    1;
    }


boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"
    outlet
    {
        type            inletOutlet;
        phi             phi.liquid;
        inletValue      uniform 0;
        value           uniform 0;
    }
    propeller
    {
        type            zeroGradient;
    }
    "vessel|shaft|walls|impeller"
    {
        type            zeroGradient;
    }
    
    nonCouple
    {
        type            zeroGradient;
    }  type            empty;
}

    massSource
    {
        type            uniformFixedValue;
        uniformValue    0;
    }



