FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      Ydefault.liquid;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"
    outlet
    {
        type            inletOutlet;
        phi             phi.liquid;
        inletValue      uniform 0;
        value           uniform 0;
    }
    propeller
    {
        type            zeroGradient;
    }
    "vessel|shaft|walls|impeller"
    {
        type            zeroGradient;
    }

    nonCouple
    {
        type            zeroGradient;
    }
}


