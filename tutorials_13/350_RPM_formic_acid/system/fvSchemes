FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         Euler;
}

gradSchemes
{
    default         cellMDLimited leastSquares 1;
    grad(U)         cellMDLimited leastSquares 1;

}

divSchemes
{
    default                         none;
    
    alphaScheme Gauss upwind;//vanLeer;
    UScheme Gauss upwind; //linearUpwind grad(U);
    generalDivScheme   Gauss upwind; // limitedLinear 1;


    div(phi,alpha.gas)              Gauss vanAlbada;
    div(phi,alpha.liquid)           Gauss vanAlbada;
    div(phir,alpha.liquid,alpha.gas) Gauss vanAlbada;
    div(phir,alpha.gas,alpha.liquid) Gauss vanAlbada;

    div(alphaRhoPhi,U)      Gauss Gamma 1;
    div(phi,U)              Gauss Gamma 1;

    "div\(alphaRhoPhi,(h|e)\)"  Gauss Gamma 1;
    "div\(alphaRhoPhi.*,Yi\)"       Gauss Gamma 1;
    "div\(alphaPhi.*,f.*\)"         Gauss Gamma 1;
    div(alphaRhoPhi,K)     Gauss Gamma 1;
    div(alphaRhoPhi,(p|rho)) Gauss Gamma 1;
    div(alphaRhoPhi,k)      Gauss upwind;

    div((((alpha*rho)*nuEff)*dev2(T(grad(U))))) Gauss linear;
    
    div(phim,epsilonm) Gauss upwind;
    div(phim,km) Gauss upwind;
    div(alphaRhoPhi,epsilon) Gauss upwind;
}

laplacianSchemes
{
    default         Gauss linear limited corrected 0.33;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         limited corrected 0.33;
}

wallDist
{
    method          Poisson;
    nRequired       true;
}


