FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "alpha.*"
    {
        nAlphaCorr      1;
        nAlphaSubCycles 1;
    }

    bubbles
    {
        nCorr                1;
        tolerance            1e-4;
        scale                true;
        solveOnFinalIterOnly true;
        sourceUpdateInterval 1;
    }

    MeshPhi
    {
        solver          GAMG;
        smoother        symGaussSeidel;
        tolerance       1e-5;
        relTol          0;
    }

    p_rgh
    {
        solver          GAMG;
        preconditioner  GaussSeidel;
        smoother        DIC;
        tolerance       1e-9;
        relTol          0.001;
        maxIter   50;
	    minIter 0;
    }

    p_rghFinal
    {
        $p_rgh;
        relTol          0;
        maxIter 50;
        minIter 1;
    }
    
     "pcorr.*"
    {
        $p_rghFinal;
        tolerance       1e-2;
        relTol          0;
    }



    "U.*"
    {
        solver          GAMG;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0;
        minIter         1;
    }

    "e.*"
    {
        solver          PBiCGStab;
        smoother        GaussSeidel;
        preconditioner  DILU;
        tolerance       1e-8;
        relTol          0;
        minIter         1;
    }
    
    "T.*"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-8;
        relTol          0;
        minIter         1;
    }

    "(k|epsilon|Yi).*"
    {
        solver          PBiCGStab;
	smoother GaussSeidel;
        preconditioner  DILU;
        tolerance       1e-9;
        relTol          0;
        minIter         1;
        maxIter         200;
    }

    "yPsi.*"
    {
        solver          GAMG;
	smoother        GaussSeidel;
        preconditioner  DIC;
        tolerance       1e-10;
        relTol          0;
    }
    
    "f.*"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-10;
        relTol          0;
    }
}

PIMPLE
{
/*
    nOuterCorrectors 1;
    nCorrectors      15;
    nNonOrthogonalCorrectors 0;
    correctMeshPhi      yes; */
    
    nNonOrthogonalCorrectors 0;
    nCorrectors          3;
    nOuterCorrectors    12;
    turbOnFinalIterOnly false;
    correctMeshPhi true;
    outerCorrectorResidualControl
    {
        U
        {
                tolerance  1e-5;
                relTol      0;
        }
        p_rgh
        {
                tolerance  1e-6;
                relTol      0;
        }
     }


    faceMomentum        yes;
    VmDdtCorrection     yes;
    dragCorrection      yes;
    interphaseHeatCorrectionScheme no;
    maxDeltaT 1e-1;
}

relaxationFactors
{
    fields
    {
        p_rgh 0.7;
    }
    
    equations
    {
        ".*"            0.99;
        "e.*"          0.8;
        "k."    0.8;
        "epsilon.*" 0.8;
    }
}

