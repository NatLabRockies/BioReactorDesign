FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k.gas;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
#include "$FOAM_CASE/constant/globalVars"
dimensions      [0 2 -2 0 0 0 0];

internalField   uniform $k_inlet_gas;

boundaryField
{
    outlet
    {
        type            inletOutlet;
        phi             phi.gas;
        inletValue      uniform $k_inlet_gas;
        value           uniform $k_inlet_gas;
    }
    propeller
    {
        type            zeroGradient;
        value           uniform $k_inlet_gas;
    }
    walls
    {
        type            zeroGradient;
        value           uniform $k_inlet_gas;
    }
    inside_to_hub
    {
        type            empty;
    }
    inside_to_hub_copy
    {
        type            empty;
    }
    hub_to_rotor
    {
        type            empty;
    }
    hub_to_rotor_copy
    {
        type            empty;
    }
}
sources
{
    massSource
    {
        type            uniformFixedValue;
        uniformValue    $k_inlet_gas;
    }

}
