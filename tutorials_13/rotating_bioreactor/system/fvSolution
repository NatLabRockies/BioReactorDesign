FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "alpha.*"
    {
        nCorrectors     1;
        nSubCycles      3;

        MULES
        {
            nIter           1;
            globalBounds    yes;
        }

        MULESCorr       yes;
        MULESCorrRelax  1;
    
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-10;
        relTol          0;
        minIter         1;

    }

    bubbles
    {
        nCorr                1;
        tolerance            1e-4;
        scale                true;
        solveOnFinalIterOnly true;
        sourceUpdateInterval 1;
    }

    MeshPhi
    {
        solver          GAMG;
        smoother        symGaussSeidel;
        tolerance       1e-5;
        relTol          0;
    }

    p_rgh
    {
        solver          PCG;
        smoother        DIC;
        preconditioner        DIC;
        tolerance       1e-11;
        relTol          0;
        maxIter   200;
	minIter 1;
    }

    p_rghFinal
    {
        $p_rgh;
        relTol          0;
        maxIter 300;
    }
    
     "pcorr.*"
    {
        $p_rghFinal;
        tolerance       1e-5;
        relTol          0;
    }



    "U.*"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-12;
        relTol          0;
        minIter         0;
    }


    "(k|omega|epsilon|Yi|e).*"
    {
        solver          PBiCGStab;
	smoother GaussSeidel;
        preconditioner  DILU;
        tolerance       1e-12;
        relTol          0;
        minIter         0;
    }

    yPsi
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-10;
        relTol          0;
    }
    
    "f.*"
    {
        solver          smoothSolver;
        smoother        GaussSeidel;
        preconditioner  DILU;
        tolerance       1e-12;
        relTol          0;
    }
}

PIMPLE
{
    nOuterCorrectors 2;
    nCorrectors      3;
    nNonOrthogonalCorrectors 1;
    correctMeshPhi      yes;
    correctPhi          yes;
    turbOnFinalIterOnly yes;
    faceMomentum        no;
    VmDdtCorrection     no;
    dragCorrection      no;
}

relaxationFactors
{
    fields
    {
        p_rgh 1;
    }
    
    equations
    {
        ".*"            1;
    }
}

cache
{
    grad(U);
}

