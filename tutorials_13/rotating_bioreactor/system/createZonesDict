FoamFile
{
    format      ascii;
    class       dictionary;
    object      createZonesDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

rS 0.021;
rH 0.001;

// Values on cross




inlet
{
	type        union;

	inlet1
	{
	    type        box;
	    zoneType    face;

	    point1      
	    (
		    #calc "-$rH" 
		    #calc "-$rS - $rH" 
		    0.01009
	    );
	    point2
	    (
		    #calc "$rH" 
		    #calc "-$rS + $rH" 
	    	0.011001
	    );
	}

	inlet2
	{
	    type        box;
	    zoneType    face;

	    point1      
	    (
		    #calc "-$rH" 
		    #calc "$rS - $rH" 
		    0.01009
	    );
	    point2
	    (
		    #calc "$rH" 
		    #calc "$rS + $rH" 
	    	0.011001
	    );
	}

	
}
