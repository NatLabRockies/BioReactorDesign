FoamFile
{
    format      ascii;
    class       dictionary;
    object      fvConstraints;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

limitp
{
    type       limitPressure;

    min        1e4;
}

limitTgas
{
    type            limitTemperature;

    select          all;

    //field           T.gas;   // Optional energy/temperature field name
                            // Set to T for compressibleVoF

    phase           gas; // Optional phase name

    min             292;
    max             295;
}

limitTliquid
{
    type            limitTemperature;

    select          all;

    //field           T.liquid;   // Optional energy/temperature field name
                            // Set to T for compressibleVoF

    phase           liquid; // Optional phase name

    min             290;
    max             300;
}
